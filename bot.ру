async def init_db():
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                is_premium INTEGER DEFAULT 0,
                is_banned INTEGER DEFAULT 0
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS msg_cache (
                msg_id TEXT PRIMARY KEY,
                chat_id INTEGER,
                sender_id INTEGER,
                sender_name TEXT,
                sender_username TEXT,
                text TEXT,
                date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        await db.commit()

async def cache_message(business_connection_id, msg: Message):
    if not msg.text: return
    msg_unique_id = f"{business_connection_id}_{msg.chat.id}_{msg.message_id}"
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "INSERT OR REPLACE INTO msg_cache (msg_id, chat_id, sender_id, sender_name, sender_username, text) VALUES (?, ?, ?, ?, ?, ?)",
            (msg_unique_id, msg.chat.id, msg.from_user.id, msg.from_user.first_name, msg.from_user.username, msg.text)
        )
        await db.commit()

# --- MIDDLEWARE ДЛЯ ПОДПИСКИ И БАНА ---
class AccessMiddleware(BaseMiddleware):
    async def __call__(self, handler, event, data):
        user = event.message.from_user if event.message else (event.callback_query.from_user if event.callback_query else None)
        
        if event.business_message or event.deleted_business_messages or event.edited_business_message:
            return await handler(event, data)

        if user:
            async with aiosqlite.connect(DB_NAME) as db:
                async with db.execute("SELECT is_banned FROM users WHERE user_id = ?", (user.id,)) as c:
                    row = await c.fetchone()
                    if row and row[0] == 1:
                        if event.callback_query:
                            await event.callback_query.answer("⛔️ Вы заблокированы.", show_alert=True)
                        return 
            
            if user.id != ADMIN_ID:
                try:
                    member = await bot.get_chat_member(CHANNEL_ID, user.id)
                    if member.status in ['left', 'kicked', 'banned']:
                        text = (
                            "⚠️ <b>Обязательная подписка!</b>\n\n"
                            "Я не работаю, пока ты не подписан на канал проекта Swithub."
                        )
                        kb = InlineKeyboardMarkup(inline_keyboard=[
                            [InlineKeyboardButton(text="💬 Канал проекта", url=CHANNEL_URL)],
                            [InlineKeyboardButton(text="🔄 Проверить подписку", callback_data="check_sub")]
                        ])
                        if event.message:
                            await event.message.answer(text, reply_markup=kb, parse_mode=ParseMode.HTML)
                        elif event.callback_query and event.callback_query.data != "check_sub":
                            await event.callback_query.message.answer(text, reply_markup=kb, parse_mode=ParseMode.HTML)
                        return
                except:
                    pass
        return await handler(event, data)

dp.update.outer_middleware(AccessMiddleware())

