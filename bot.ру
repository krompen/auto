@dp.callback_query(F.data == "confirm_buy")
async def cb_confirm_buy(call: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    item = GIFTS[data["item_id"]]
    total = item["price"] + data["extra_price"]
    target_id = data["target_id"]
    
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT balance FROM users WHERE user_id = ?", (call.from_user.id,)) as c:
            balance = (await c.fetchone())[0]
            
        if balance < total:
            return await call.answer("❌ Недостаточно средств на балансе!", show_alert=True)
            
        await db.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (total, call.from_user.id))
        await db.commit()

    sender_name = f"@{call.from_user.username}" if call.from_user.username else call.from_user.first_name
    gift_msg = (
        f"🎉 <b>Вам прислали подарок!</b>\n\n"
        f"От кого: {sender_name}\n"
        f"Подарок: <b>{item['name']}</b>\n"
        f"Гравировка: <i>«{data['desc_text']}»</i>"
    )
    try:
        await bot.send_message(target_id, gift_msg, parse_mode=ParseMode.HTML)
        await call.message.edit_text("✅ <b>Подарок успешно отправлен!</b>", reply_markup=cancel_kb(), parse_mode=ParseMode.HTML)
    except Exception:
        # Если юзер заблочил бота, возвращаем деньги
        async with aiosqlite.connect(DB_NAME) as db:
            await db.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (total, call.from_user.id))
            await db.commit()
        await call.message.edit_text("❌ <b>Ошибка отправки.</b> Получатель заблокировал бота. Средства возвращены.", reply_markup=cancel_kb(), parse_mode=ParseMode.HTML)
    
    await state.clear()

