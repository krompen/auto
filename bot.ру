async def check_subscription(bot: Bot, user_id: int) -> bool:
    if user_id == ADMIN_ID:
        return True
    try:
        member = await bot.get_chat_member(f"@{CHANNEL_USERNAME}", user_id)
        return member.status in {ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR}
    except Exception:
        logger.exception("Subscription check failed")
        # A Telegram API/configuration failure must not lock every user out.
        return True


def readable_username() -> str:
    pattern = random.choice(("CVCVC", "CVCCV", "VCCVC", "VCVCV"))
    return "".join(random.choice(CONSONANTS if c == "C" else VOWELS) for c in pattern).lower()


def username_from_mask(mask: str) -> Optional[str]:
    mask = mask.strip().lower()
    if len(mask) != 5:
        return None
    result = []
    for char in mask:
        if char in "?*_":
            result.append(random.choice(CONSONANTS + VOWELS))
        elif "a" <= char <= "z":
            result.append(char)
        else:
            return None
    value = "".join(result)
    return value if USERNAME_RE.fullmatch(value) else None


async def username_available(session: aiohttp.ClientSession, username: str) -> bool:
    if not USERNAME_RE.fullmatch(username):
        return False
    try:
        async with session.get(
            f"https://t.me/{username}",
            headers={"User-Agent": "Mozilla/5.0"},
            allow_redirects=False,
            timeout=aiohttp.ClientTimeout(total=8),
        ) as response:
            # 404 is the only conservative indication of an unused public username.
            return response.status == 404
    except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
        logger.warning("Username check failed for %s: %s", username, exc)
        return False


