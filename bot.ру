        if not owner_row: return
        owner_id = owner_row[0]

    for msg_id in deleted.message_ids:
        msg_unique_id = f"{deleted.business_connection_id}_{deleted.chat.id}_{msg_id}"
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT sender_name, sender_username, text FROM msg_cache WHERE msg_id = ?", (msg_unique_id,)) as cursor:
                row = await cursor.fetchone()
                if row:
                    sender_name, sender_username, text = row
                    username_str = f"@{sender_username}" if sender_username else sender_name
                    log_text = (
                        f"🗑 <b>Удалено сообщение от {username_str}</b>\n\n"
                        f"<b>Текст:</b> {text}"
                    )
                    try: await bot.send_message(owner_id, log_text, parse_mode=ParseMode.HTML)
                    except: pass

