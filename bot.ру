@router.message(StateFilter(SearchStates.waiting_for_mask))
async def mask_input(message: Message, state: FSMContext) -> None:
    mask = (message.text or "").strip().lower()
    if len(mask) != 5 or any(c not in "?*_abcdefghijklmnopqrstuvwxyz" for c in mask):
        await message.answer("⚠️ Маска должна содержать ровно 5 латинских букв или знаков ?.")
        return
    await state.clear()
    msg = await message.answer("🔍 Проверяем...")
    async with aiohttp.ClientSession() as session:
        found = await scan(session, lambda: username_from_mask(mask), attempts=12)
    result = "\n".join(f"💎 <code>@{name}</code> — свободен" for name in found) or "Ничего не найдено."
    await msg.edit_text(f"🎯 <b>Результат для <code>{html.escape(mask)}</code></b>\n\n{result}",
                        reply_markup=kb([[InlineKeyboardButton(text="⬅️ В меню", callback_data="btn_menu")]]))


