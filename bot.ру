@router.message(StateFilter(SearchStates.admin_broadcast))
async def broadcast(message: Message, state: FSMContext, bot: Bot) -> None:
    if message.from_user.id != ADMIN_ID:
        return
    text = message.text
    if not text:
        await message.answer("⚠️ Нужен текст сообщения.")
        return
    await state.clear()
    with sqlite3.connect(DB_PATH) as conn:
        users = [row[0] for row in conn.execute("SELECT user_id FROM users")]
    sent = 0
    for user_id in users:
        try:
            await bot.send_message(user_id, text)
            sent += 1
        except Exception:
            pass
        await asyncio.sleep(0.05)
    await message.answer(f"✅ Доставлено: <b>{sent}</b>", reply_markup=admin_keyboard())


async def trap_watcher(bot: Bot) -> None:
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                traps = conn.execute("SELECT id, user_id, username FROM traps WHERE is_active = 1").fetchall()
            async with aiohttp.ClientSession() as session:
                for trap_id, user_id, username in traps:
                    if await username_available(session, username):
                        try:
                            await bot.send_message(user_id, f"🚨 Юзернейм <b>@{html.escape(username)}</b> освободился!")
                        except Exception:
                            logger.exception("Could not notify trap owner")
                        with sqlite3.connect(DB_PATH) as conn:
                            conn.execute("UPDATE traps SET is_active = 0 WHERE id = ?", (trap_id,))
                    await asyncio.sleep(2)
        except asyncio.CancelledError:
            raise
        except Exception:
            logger.exception("Trap watcher failed")
        await asyncio.sleep(60)


async def main() -> None:
    init_db()
    bot = Bot(BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dispatcher = Dispatcher(storage=MemoryStorage())
    dispatcher.include_router(router)
    watcher = asyncio.create_task(trap_watcher(bot))
    try:
        await bot.delete_webhook(drop_pending_updates=True)
        await dispatcher.start_polling(bot)
    finally:
        watcher.cancel()
        await asyncio.gather(watcher, return_exceptions=True)
        await bot.session.close()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Бот остановлен")
