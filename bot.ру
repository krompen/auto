# Отлов статуса подключения к бизнес-аккаунту
@dp.business_connection()
async def handle_biz_connection(connection: BusinessConnection):
    async with aiosqlite.connect(DB_NAME) as db:
        if connection.is_enabled:
            await db.execute("INSERT OR REPLACE INTO connections (conn_id, owner_id) VALUES (?, ?)", (connection.id, connection.user.id))
            await bot.send_message(
                connection.user.id, 
                "✅ <b>Бот успешно подключен к вашей странице!</b>\nТеперь я отслеживаю удаленные и измененные сообщения.\n\nНапишите <code>/help</code> в любом чате, чтобы узнать бизнес-команды.", 
                parse_mode=ParseMode.HTML
            )
        else:
            await db.execute("DELETE FROM connections WHERE conn_id = ?", (connection.id,))
            await bot.send_message(
                connection.user.id, 
                "❌ <b>Бот отключен от вашей страницы.</b>\nРабота логгера приостановлена.", 
                parse_mode=ParseMode.HTML
            )
        await db.commit()

@dp.business_message()
async def handle_new_business_message(message: Message):
    # Узнаем владельца бизнес-подключения
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT owner_id FROM connections WHERE conn_id = ?", (message.business_connection_id,)) as cursor:
            owner_row = await cursor.fetchone()
        if not owner_row: return
        owner_id = owner_row[0]

    # Кэшируем сообщение на случай изменения/удаления
    await cache_message(message.business_connection_id, message)

    # ОБРАБОТКА КОМАНД ОТ ВЛАДЕЛЬЦА В ЛС
    if message.from_user.id == owner_id and message.text:
        target_id = message.chat.id # ID того, с кем переписывается владелец
        
        if message.text.startswith("/help"):
            help_text = (
                "🛠 <b>Бизнес-команды Swithub:</b>\n\n"
                "<code>/mute</code> — заглушить пользователя (бот будет отвечать, что он в муте)\n"
                "<code>/unmute</code> — снять мут"
            )
            await bot.send_message(message.chat.id, help_text, business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            
        elif message.text.startswith("/mute"):
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("INSERT OR IGNORE INTO muted (owner_id, target_id) VALUES (?, ?)", (owner_id, target_id))
                await db.commit()
            await bot.send_message(message.chat.id, "🔇 <b>Пользователь добавлен в черный список бота.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            
        elif message.text.startswith("/unmute"):
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("DELETE FROM muted WHERE owner_id = ? AND target_id = ?", (owner_id, target_id))
                await db.commit()
            await bot.send_message(message.chat.id, "🔊 <b>Ограничения с пользователя сняты.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
    
    # ЕСЛИ ПИШЕТ СОБЕСЕДНИК (Проверка на мут)
    elif message.from_user.id != owner_id:
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT 1 FROM muted WHERE owner_id = ? AND target_id = ?", (owner_id, message.chat.id)) as cursor:
                is_muted = await cursor.fetchone()
        
        if is_muted:
            # Бот автоматически отвечает замученному юзеру
            await bot.send_message(
                message.chat.id, 
                "🚫 <i>Вы были заглушены владельцем аккаунта. Ваши сообщения могут игнорироваться.</i>", 
                business_connection_id=message.business_connection_id, 
                parse_mode=ParseMode.HTML
            )

@dp.edited_business_message()
async def handle_edited_business_message(message: Message):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT owner_id FROM connections WHERE conn_id = ?", (message.business_connection_id,)) as cursor:
            owner_row = await cursor.fetchone()
        if not owner_row: return
        owner_id = owner_row[0]

    msg_unique_id = f"{message.business_connection_id}_{message.chat.id}_{message.message_id}"
    
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT text FROM msg_cache WHERE msg_id = ?", (msg_unique_id,)) as cursor:
            row = await cursor.fetchone()
            old_text = row[0] if row else "<i>[Текст не был сохранен]</i>"
            
    username = f"@{message.from_user.username}" if message.from_user.username else message.from_user.first_name
    log_text = (
        f"✏️ <b>Изменено сообщение пользователя {username} ({message.from_user.first_name})</b>\n\n"
        f"<b>Старый текст:</b> {old_text}\n"
        f"<b>Новый текст:</b> {message.text}"
    )
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="Перейти в чат", url=f"tg://resolve?domain={message.chat.username}")] 
    ])
    
    # Отправляем лог владельцу в личку бота
    try:
        await bot.send_message(owner_id, log_text, reply_markup=kb, parse_mode=ParseMode.HTML)
    except: pass
    
    await cache_message(message.business_connection_id, message)

@dp.deleted_business_messages()
async def handle_deleted_business_messages(deleted: BusinessMessagesDeleted):
    # Узнаем кому слать лог об удалении
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT owner_id FROM connections WHERE conn_id = ?", (deleted.business_connection_id,)) as cursor:
            owner_row = await cursor.fetchone()
        if not owner_row: return
        owner_id = owner_row[0]

    for msg_id in deleted.message_ids:
        msg_unique_id = f"{deleted.business_connection_id}_{deleted.chat.id}_{msg_id}"
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT sender_name, sender_username, text FROM msg_cache WHERE msg_id = ?", (msg_unique_id,)) as cursor:
                row = await cursor.fetchone()
                if row:
                    sender_name, sender_username, text = row
                    username_str = f"@{sender_username}" if sender_username else sender_name
                    
                    log_text = (
                        f"🗑 <b>Удалено сообщение пользователя {username_str} ({sender_name})</b>\n\n"
                        f"<b>Текст:</b> {text}"
                    )
                    
                    # Отправляем лог владельцу в личку бота
                    try:
                        await bot.send_message(owner_id, log_text, parse_mode=ParseMode.HTML)
                    except: pass

