async def background_trap_watcher(bot: Bot):
    """Фоновый снайпер юзернеймов"""
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT id, user_id, username FROM traps WHERE is_active = 1")
                traps = cursor.fetchall()

            if traps:
                async with aiohttp.ClientSession() as session:
                    for trap_id, user_id, uname in traps:
                        is_free = await check_telegram_username_available(session, uname)
                        if is_free:
                            # Оповещаем пользователя
                            try:
                                alert_text = (
                                    f"🚨 <b>ВНИМАНИЕ! ЛОВУШКА СРАБОТАЛА!</b>\n\n"
                                    f"Юзернейм <b>@{uname}</b> только что освободился!\n"
                                    f"👉 <a href='https://t.me/{uname}'>Перейти и занять прямо сейчас!</a>"
                                )
                                await bot.send_message(chat_id=user_id, text=alert_text, parse_mode=ParseMode.HTML)
                            except Exception as e:
                                logger.error(f"Не удалось отправить уведомление о ловушке: {e}")

                            # Деактивируем ловушку
                            with sqlite3.connect(DB_PATH) as conn_up:
                                conn_up.execute("UPDATE traps SET is_active = 0 WHERE id = ?", (trap_id,))
                                conn_up.commit()
                        await asyncio.sleep(2)

        except Exception as e:
            logger.error(f"Ошибка в фоновом воркере ловушек: {e}")

        # Проверка каждые 60 секунд
        await asyncio.sleep(60)

async def main():
    """Точка запуска бота Swithub"""
    bot = Bot(
        token=BOT_TOKEN,
        default=DefaultBotProperties(parse_mode=ParseMode.HTML),
    )
    storage = MemoryStorage()
    dp = Dispatcher(storage=storage)
    dp.include_router(router)

    # Запуск фонового чекера ловушек
    asyncio.create_task(background_trap_watcher(bot))

    logger.info("Бот Swithub успешно запущен!")
    try:
        await bot.delete_webhook(drop_pending_updates=True)
        await dp.start_polling(bot)
    finally:
        await bot.session.close()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Бот остановлен.")

