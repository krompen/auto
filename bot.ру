@dp.message(StateFilter(CasinoFSM.waiting_for_bet))
async def process_bet(message: Message, state: FSMContext):
    if not message.text.isdigit(): return await message.answer("❌ Введи число.")
    bet = int(message.text)
    if bet <= 0: return await message.answer("❌ Ставка должна быть больше 0.")

    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT balance FROM users WHERE user_id = ?", (message.from_user.id,)) as c:
            balance = (await c.fetchone())[0]
            
    if balance < bet:
        return await message.answer(f"❌ Недостаточно средств. Ваш баланс: {balance} ⭐️", reply_markup=cancel_kb())
        
    await state.clear()
    
    # Списываем ставку сразу
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (bet, message.from_user.id))
        await db.commit()

    dice_msg = await message.answer_dice(emoji="🎰")
    await asyncio.sleep(2.5) # Ждем анимацию
    
    # Логика автомата 🎰: 1, 22, 43, 64 - это три одинаковые картинки
    win_values = [1, 22, 43, 64]
    
    # Делаем "наебалово", но даем шанс
    is_win = random.random() < 0.25 # Шанс 25% на утешительный x2, джекпот ловим через dice.value
    
    if dice_msg.dice.value in win_values:
        win_amount = bet * 10
        result = f"🔥 <b>ДЖЕКПОТ!</b> Ты выиграл {win_amount} ⭐️!"
    elif is_win:
        win_amount = bet * 2
        result = f"✅ <b>Победа!</b> Ты выиграл {win_amount} ⭐️."
    else:
        win_amount = 0
        result = "❌ <b>Проигрыш.</b> Повезет в следующий раз!"

    if win_amount > 0:
        async with aiosqlite.connect(DB_NAME) as db:
            await db.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (win_amount, message.from_user.id))
            await db.commit()
            
    await message.answer(result, reply_markup=cancel_kb(), parse_mode=ParseMode.HTML)

