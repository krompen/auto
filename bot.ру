def now_ts() -> int:
    return int(dt.datetime.now(dt.timezone.utc).timestamp())


def init_db() -> None:
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT NOT NULL DEFAULT '',
                first_name TEXT NOT NULL DEFAULT '',
                vip_until INTEGER NOT NULL DEFAULT 0,
                daily_searches INTEGER NOT NULL DEFAULT 0,
                last_search_date TEXT NOT NULL DEFAULT '',
                created_at INTEGER NOT NULL
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS traps (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                username TEXT NOT NULL,
                created_at INTEGER NOT NULL,
                is_active INTEGER NOT NULL DEFAULT 1,
                UNIQUE(user_id, username, is_active)
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_traps_active ON traps(is_active)")


def get_user_db(user_id: int, username: str = "", first_name: str = "") -> dict:
    today = dt.datetime.now(dt.timezone.utc).date().isoformat()
    with sqlite3.connect(DB_PATH) as conn:
        row = conn.execute(
            "SELECT user_id, username, first_name, vip_until, daily_searches, last_search_date "
            "FROM users WHERE user_id = ?", (user_id,)
        ).fetchone()
        if row is None:
            conn.execute(
                "INSERT INTO users(user_id, username, first_name, last_search_date, created_at) "
                "VALUES (?, ?, ?, ?, ?)", (user_id, username, first_name, today, now_ts())
            )
            return {"user_id": user_id, "username": username, "first_name": first_name,
                    "vip_until": 0, "daily_searches": 0, "last_search_date": today}

        daily = row[4] if row[5] == today else 0
        conn.execute(
            "UPDATE users SET username = ?, first_name = ?, daily_searches = ?, last_search_date = ? "
            "WHERE user_id = ?", (username or row[1], first_name or row[2], daily, today, user_id)
        )
        return {"user_id": row[0], "username": username or row[1], "first_name": first_name or row[2],
                "vip_until": row[3], "daily_searches": daily, "last_search_date": today}


def is_vip(user: dict) -> bool:
    return user["user_id"] == ADMIN_ID or user["vip_until"] > now_ts()


def increment_search_count(user_id: int) -> None:
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("UPDATE users SET daily_searches = daily_searches + 1 WHERE user_id = ?", (user_id,))


