VOWELS = ["a", "e", "i", "o", "u"]
CONSONANTS = ["b", "c", "d", "f", "g", "h", "k", "l", "m", "n", "p", "r", "s", "t", "v", "w", "z"]

def generate_readable_5letter() -> str:
    """Генерация читаемых пятибуквенных слов без цифр"""
    # Схемы: CVCVC (напр. batel, moris), CVCCV (danto), VCCVC (alvin)
    pattern = random.choice(["CVCVC", "CVCVC", "CVCCV", "VCCVC", "VCVCV"])
    word = []
    for char in pattern:
        if char == "C":
            word.append(random.choice(CONSONANTS))
        else:
            word.append(random.choice(VOWELS))
    return "".join(word)

def generate_by_mask(mask: str) -> Optional[str]:
    """Генерация 5-буквенного логина по маске (например: a?b?c)"""
    mask = mask.lower().strip()
    if len(mask) != 5:
        return None
    res = []
    for ch in mask:
        if ch in ("?", "*", "_"):
            res.append(random.choice(CONSONANTS + VOWELS))
        elif ch.isalpha():
            res.append(ch)
        else:
            return None
    return "".join(res)

async def check_telegram_username_available(session: aiohttp.ClientSession, username: str) -> bool:
    """Проверка доступности имени пользователя через публичные страницы Telegram"""
    url = f"https://t.me/{username}"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
    try:
        async with session.get(url, headers=headers, timeout=aiohttp.ClientTimeout(total=8)) as response:
            if response.status == 200:
                html = await response.text()
                # Признаки занятого юзернейма на t.me:
                # 1. Присутствует кнопка "Send Message" / "View in Telegram"
                # 2. Наличие мета-тега robot или og:title
                # 3. Отсутствие блока "tgme_page_action" с прямым переходом говорит о свободной странице
                if 'class="tgme_action_button_new' in html or 'tgme_page_action' in html:
                    # Дополнительно проверяем, если это страница пользователя или канала
                    if 'tgme_page_photo' in html or 'tgme_page_title' in html:
                        return False
                
                # Если страница существует, но не имеет профиля/описания/действия:
                if 'If you have <strong>Telegram</strong>, you can contact' not in html:
                    return True
                return False
            elif response.status == 404:
                return True
            return False
    except Exception as e:
        logger.error(f"Ошибка проверки юзернейма {username}: {e}")
        return False

