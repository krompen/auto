        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"Статус: <b>{status_ban}</b>\n"
        f"Премиум: <b>{status_prem}</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"Выберите действие:"
    )
    await message.answer(text, reply_markup=user_control_kb(target_id, is_banned, is_premium), parse_mode=ParseMode.HTML)
    await state.clear()

@dp.callback_query(F.data.startswith("adm_"), F.from_user.id == ADMIN_ID)
async def cb_adm_actions(call: CallbackQuery):
    action = call.data.split("_")[1]
    
    if action not in ["ban", "unban", "giveprem", "remprem"]: return
    target_id = int(call.data.split("_")[2])

    async with aiosqlite.connect(DB_NAME) as db:
        if action == "ban":
            await db.execute("UPDATE users SET is_banned = 1 WHERE user_id = ?", (target_id,))
            msg = f"⛔️ Пользователь {target_id} заблокирован."
        elif action == "unban":
            await db.execute("UPDATE users SET is_banned = 0 WHERE user_id = ?", (target_id,))
            msg = f"🟢 Пользователь {target_id} разблокирован."
        elif action == "giveprem":
            await db.execute("UPDATE users SET is_premium = 1 WHERE user_id = ?", (target_id,))
            msg = f"💎 Премиум выдан {target_id}."
            try: await bot.send_message(target_id, "🎁 Администратор выдал вам Премиум!") 
            except: pass
        elif action == "remprem":
            await db.execute("UPDATE users SET is_premium = 0 WHERE user_id = ?", (target_id,))
            msg = f"❌ Премиум снят у {target_id}."
        
        await db.commit()
        
        async with db.execute("SELECT is_banned, is_premium FROM users WHERE user_id = ?", (target_id,)) as cursor:
            is_banned, is_premium = await cursor.fetchone()

    status_ban = "🔴 Заблокирован" if is_banned else "🟢 Активен"
    status_prem = "💎 Есть" if is_premium else "❌ Нет"

    text = (
        f"👤 <b>Карточка пользователя:</b> <code>{target_id}</code>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"Статус: <b>{status_ban}</b>\n"
        f"Премиум: <b>{status_prem}</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"Выберите действие:"
    )
    await call.message.edit_text(text, reply_markup=user_control_kb(target_id, is_banned, is_premium), parse_mode=ParseMode.HTML)
    await call.answer(msg, show_alert=True)

