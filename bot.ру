    await log_message(message.from_user.id, is_anon=1)
    reply_btn = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="💬 Ответить анонимно", callback_data=f"reply_to_{message.from_user.id}")]
    ])
    await bot.send_message(ADMIN_ID, "🎭 <b>Анонимный вопрос:</b>", parse_mode="HTML")
    await bot.copy_message(chat_id=ADMIN_ID, from_chat_id=message.chat.id, message_id=message.message_id, reply_markup=reply_btn)
    await message.answer("🔒 Анонимный вопрос отправлен!", reply_markup=main_menu_kb(message.from_user.id))
    await state.clear()

