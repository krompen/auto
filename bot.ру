@dp.callback_query(F.data == "adm_stats", F.from_user.id == ADMIN_ID)
async def cb_adm_stats(call: CallbackQuery):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT COUNT(*), SUM(balance) FROM users") as cursor:
            row = await cursor.fetchone()
            total_users = row[0]
            total_pizzas = row[1] if row[1] else 0
            
    await call.message.edit_text(
        f"📊 <b>Статистика:</b>\n👥 Юзеров: {total_users}\n🍕 Пицц на руках: {total_pizzas}",
        reply_markup=admin_kb(), parse_mode="HTML"
    )

@dp.callback_query(F.data == "adm_give", F.from_user.id == ADMIN_ID)
async def cb_adm_give(call: CallbackQuery, state: FSMContext):
    await state.set_state(AdminPanel.waiting_for_user_id)
    await call.message.edit_text("Введите ID пользователя, которому нужно выдать пиццы:", reply_markup=cancel_kb())

@dp.message(StateFilter(AdminPanel.waiting_for_user_id), F.from_user.id == ADMIN_ID)
async def adm_process_id(message: Message, state: FSMContext):
    await state.update_data(target_id=int(message.text))
    await state.set_state(AdminPanel.waiting_for_amount)
    await message.answer("Сколько пицц выдать?", reply_markup=cancel_kb())

@dp.message(StateFilter(AdminPanel.waiting_for_amount), F.from_user.id == ADMIN_ID)
async def adm_process_amount(message: Message, state: FSMContext):
    data = await state.get_data()
    target_id = data["target_id"]
    amount = int(message.text)
    
    await update_balance(target_id, amount)
    await message.answer(f"✅ Успешно выдано {amount} пицц пользователю {target_id}.", reply_markup=InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="В админку", callback_data="admin_menu")]]))
    await state.clear()

async def main():
    await init_db()
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())

