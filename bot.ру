def get_user_db(user_id: int, username: str = "", first_name: str = ""):
    """Получение или регистрация пользователя"""
    now_ts = int(datetime.datetime.now().timestamp())
    today_str = datetime.date.today().isoformat()
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT user_id, username, first_name, vip_until, daily_searches, last_search_date FROM users WHERE user_id = ?", (user_id,))
        row = cursor.fetchone()
        if not row:
            cursor.execute(
                "INSERT INTO users (user_id, username, first_name, vip_until, daily_searches, last_search_date, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                (user_id, username, first_name, 0, 0, today_str, now_ts)
            )
            conn.commit()
            return {"user_id": user_id, "username": username, "first_name": first_name, "vip_until": 0, "daily_searches": 0, "last_search_date": today_str}
        
        # Сброс дневного счетчика при смене даты
        vip_until = row[3]
        daily_searches = row[4]
        last_date = row[5]
        if last_date != today_str:
            daily_searches = 0
            cursor.execute("UPDATE users SET daily_searches = 0, last_search_date = ? WHERE user_id = ?", (today_str, user_id))
            conn.commit()
            
        return {
            "user_id": row[0],
            "username": row[1],
            "first_name": row[2],
            "vip_until": vip_until,
            "daily_searches": daily_searches,
            "last_search_date": today_str,
        }

