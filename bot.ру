@dp.callback_query(F.data.startswith("adm_manage_"), F.from_user.id == ADMIN_ID)
async def cb_adm_manage_user(call: CallbackQuery):
    target_id = int(call.data.split("_")[2])
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT is_banned, balance FROM users WHERE user_id = ?", (target_id,)) as cursor:
            row = await cursor.fetchone()
            
    if not row: return await call.answer("Не найден!", show_alert=True)
    is_banned, balance = row

    ban_text = "🔄 Разбанить" if is_banned else "⛔️ Забанить"
    ban_cb = f"adm_unban_{target_id}" if is_banned else f"adm_ban_{target_id}"
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=ban_text, callback_data=ban_cb)],
        [InlineKeyboardButton(text="✉️ Написать в ЛС", callback_data=f"adm_msg_{target_id}")],
        [InlineKeyboardButton(text="🔙 К списку", callback_data="adm_users_0")]
    ])
    text = f"👤 <b>Юзер:</b> <code>{target_id}</code>\nБаланс: {balance} ⭐️\nСтатус: {'🔴 Бан' if is_banned else '🟢 Активен'}"
    await call.message.edit_text(text, reply_markup=kb, parse_mode=ParseMode.HTML)

@dp.callback_query(F.data.startswith("adm_unban_") | F.data.startswith("adm_ban_"), F.from_user.id == ADMIN_ID)
async def cb_adm_actions(call: CallbackQuery):
    action = call.data.split("_")[1]
    target_id = int(call.data.split("_")[2])
    val = 1 if action == "ban" else 0

    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("UPDATE users SET is_banned = ? WHERE user_id = ?", (val, target_id))
        await db.commit()
    await call.answer("✅ Статус изменен", show_alert=True)
    await cb_adm_manage_user(call) # Перерисовываем

@dp.callback_query(F.data == "adm_broadcast", F.from_user.id == ADMIN_ID)
async def cb_adm_broadcast(call: CallbackQuery, state: FSMContext):
    await state.set_state(AdminFSM.waiting_for_broadcast)
    await call.message.edit_text("📢 Отправь текст для рассылки:", reply_markup=InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="🔙 Отмена", callback_data="adm_main")]]))

@dp.message(StateFilter(AdminFSM.waiting_for_broadcast), F.from_user.id == ADMIN_ID)
async def process_broadcast(message: Message, state: FSMContext):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT user_id FROM users WHERE is_banned = 0") as cursor:
            users = await cursor.fetchall()

    status = await message.answer("⏳ Запуск рассылки...")
    success = 0
    for (uid,) in users:
        try:
            await bot.copy_message(chat_id=uid, from_chat_id=message.chat.id, message_id=message.message_id)
            success += 1
            await asyncio.sleep(0.05)
        except: pass

    await status.edit_text(f"📢 <b>Рассылка завершена.</b> Доставлено: {success}", reply_markup=InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="🔙 В админку", callback_data="adm_main")]]), parse_mode=ParseMode.HTML)
    await state.clear()

async def main():
    await init_db()
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())

