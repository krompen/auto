        return await message.answer("❌ Юзер не найден в базе.", reply_markup=cancel_kb())

    is_banned, is_premium = row
    status_ban = "🔴 Заблокирован" if is_banned else "🟢 Активен"
    status_prem = "💎 Есть" if is_premium else "❌ Нет"

