@dp.message(StateFilter(UserStates.waiting_for_message))
async def process_user_msg(message: Message, state: FSMContext):
    await log_message(message.from_user.id, is_anon=0)
    reply_btn = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="💬 Ответить", callback_data=f"reply_to_{message.from_user.id}")]
    ])
    header = (
        f"📩 <b>Новое обращение:</b>\n"
        f"• От: @{message.from_user.username or 'отсутствует'}\n"
        f"• ID: <code>{message.from_user.id}</code>\n\n"
    )
    await bot.send_message(ADMIN_ID, header, parse_mode="HTML")
    await bot.copy_message(chat_id=ADMIN_ID, from_chat_id=message.chat.id, message_id=message.message_id, reply_markup=reply_btn)
    await message.answer("✅ Сообщение доставлено!", reply_markup=main_menu_kb(message.from_user.id))
    await state.clear()

@dp.message(StateFilter(UserStates.waiting_for_anon_question))
