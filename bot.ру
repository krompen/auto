async def scan(session: aiohttp.ClientSession, generator, attempts: int = 15, limit: int = 3) -> list[str]:
    found: list[str] = []
    seen: set[str] = set()
    for _ in range(attempts):
        candidate = generator()
        if not candidate or candidate in seen:
            continue
        seen.add(candidate)
        if await username_available(session, candidate):
            found.append(candidate)
            if len(found) >= limit:
                break
        await asyncio.sleep(0.3)
    return found


