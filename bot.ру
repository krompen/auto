    await state.clear()
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)", 
                         (message.from_user.id, message.from_user.username))
        await db.commit()
    
    text = (
        "🦅 <b>Vultures Delivery Network</b>\n"
        "━━━━━━━━━━━━━━━━━━━━\n"
        "Анонимный сервис заказа «Пиццы».\n"
        "Мы доставляем проблемы прямо на аккаунт вашей цели. Массовые жалобы, спам-блок, теневой бан.\n\n"
        "Выберите действие в меню:"
    )
    await message.answer(text, reply_markup=main_menu_kb(message.from_user.id), parse_mode="HTML")

