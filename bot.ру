# --- База данных ---
async def init_db():
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                is_banned INTEGER DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS messages_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                is_anon INTEGER DEFAULT 0,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        # Попытка добавить колонку is_banned, если база старая
        try:
            await db.execute("ALTER TABLE users ADD COLUMN is_banned INTEGER DEFAULT 0")
        except aiosqlite.OperationalError:
            pass 
        await db.commit()

async def add_user(user_id: int, username: str):
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)",
            (user_id, username or "отсутствует")
        )
        await db.commit()

async def log_message(user_id: int, is_anon: int = 0):
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("INSERT INTO messages_log (user_id, is_anon) VALUES (?, ?)", (user_id, is_anon))
        await db.commit()

async def set_user_ban(user_id: int, status: int):
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("UPDATE users SET is_banned = ? WHERE user_id = ?", (status, user_id))
        await db.commit()

# --- Middleware для проверки блокировки ---
class BanCheckMiddleware(BaseMiddleware):
    async def __call__(self, handler, event: Update, data: dict):
        user = event.message.from_user if event.message else (event.callback_query.from_user if event.callback_query else None)
        if not user or user.id == ADMIN_ID:
            return await handler(event, data)
        
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT is_banned FROM users WHERE user_id = ?", (user.id,)) as cursor:
                row = await cursor.fetchone()
                if row and row[0] == 1:
                    if event.callback_query:
                        await event.callback_query.answer("⛔️ Вы заблокированы в этом боте.", show_alert=True)
                    return # Игнорируем заблокированного
        return await handler(event, data)

dp.update.outer_middleware(BanCheckMiddleware())

