import asyncio
import logging
from aiogram import Bot, Dispatcher, F
from aiogram.types import (
    Message, CallbackQuery,
    InlineKeyboardMarkup, InlineKeyboardButton, ReplyKeyboardRemove
)
from aiogram.filters import CommandStart, StateFilter
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import StatesGroup, State
import aiosqlite

BOT_TOKEN = "8989551756:AAHLhaGlQ-chF3NG4EeGcuwOl5ih1CT7GcE"
ADMIN_ID = 8724732477
DB_NAME = "bot_database.db"

logging.basicConfig(level=logging.INFO)
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()

# --- FSM (Состояния диалога) ---
class UserStates(StatesGroup):
    waiting_for_message = State()
    waiting_for_anon_question = State()

class AdminStates(StatesGroup):
    waiting_for_reply = State()
    waiting_for_broadcast = State()

# --- База данных (SQLite) ---
async def init_db():
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS messages_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                is_anon INTEGER DEFAULT 0,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        await db.commit()

async def add_user(user_id: int, username: str):
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)",
            (user_id, username or "отсутствует")
        )
        await db.commit()

async def log_message(user_id: int, is_anon: int = 0):
    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "INSERT INTO messages_log (user_id, is_anon) VALUES (?, ?)",
            (user_id, is_anon)
        )
        await db.commit()

# --- Меню и кнопки ---
