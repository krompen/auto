@dp.callback_query(F.data.startswith("buy_"))
async def process_buy(call: CallbackQuery):
    amount = int(call.data.split("_")[1])
    
    # Настройка цен в звездах (XTR)
    prices_map = {
        1: 15,
        3: 40,
        10: 75
    }
    stars_amount = prices_map[amount]
    
    await bot.send_invoice(
        chat_id=call.from_user.id,
        title=f"Заказ {amount} Пицц(ы)",
        description=f"Пакет на {amount} сносов. Пополнение внутреннего баланса.",
        payload=f"buy_pizzas_{amount}",
        provider_token="", # Для XTR токен провайдера должен быть пустым
        currency="XTR",
        prices=[LabeledPrice(label=f"{amount} Пицц(ы)", amount=stars_amount)]
    )
    await call.answer()

@dp.pre_checkout_query()
async def pre_checkout_handler(pre_checkout_query: PreCheckoutQuery):
    await bot.answer_pre_checkout_query(pre_checkout_query.id, ok=True)

@dp.message(F.successful_payment)
async def successful_payment_handler(message: Message):
    payload = message.successful_payment.invoice_payload
    if payload.startswith("buy_pizzas_"):
        amount = int(payload.split("_")[2])
        await update_balance(message.from_user.id, amount)
        
        receipt = (
            "🧾 <b>Чек об оплате</b>\n"
            "━━━━━━━━━━━━━━━━━━━━\n"
            f"✅ Успешно куплено: <b>{amount} Пицц</b>\n"
            "Баланс пополнен. Можете приступать к заказу."
        )
        await message.answer(receipt, parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="В меню", callback_data="back_main")]]))

# --- Процесс "Сноса" (Пранк-анимация) ---
@dp.callback_query(F.data == "order_pizza")
async def cb_order_pizza(call: CallbackQuery, state: FSMContext):
    user = await get_user(call.from_user.id)
    if not user or user[0] < 1:
        await call.answer("❌ У вас нет доступных пицц! Пополните баланс.", show_alert=True)
        return

    await state.set_state(OrderPizza.waiting_for_target)
    await call.message.edit_text(
        "🍕 <b>Оформление заказа</b>\n"
        "━━━━━━━━━━━━━━━━━━━━\n"
        "Введите юзернейм (например, @target) или ID жертвы, на которую оформляем снос:",
        reply_markup=cancel_kb(), parse_mode="HTML"
    )

@dp.message(StateFilter(OrderPizza.waiting_for_target))
async def process_target(message: Message, state: FSMContext):
    target = message.text
    await update_balance(message.from_user.id, -1)
    await state.clear()
    
    # Фейковая анимация "сноса"
    status_msg = await message.answer(f"🕒 <i>Инициализация заказа на {target}...</i>", parse_mode="HTML")
    await asyncio.sleep(2)
    
    await status_msg.edit_text(f"🧑‍🍳 <b>Подготовка сессий...</b>\nПоднимаем 200 Android-клиентов для {target}...", parse_mode="HTML")
    await asyncio.sleep(2.5)
    
    await status_msg.edit_text(f"🔥 <b>Прогрев аккаунтов завершен.</b>\nАвторизация в Telegram API...\n[████████░░] 80%", parse_mode="HTML")
    await asyncio.sleep(2)
    
    await status_msg.edit_text(f"📨 <b>Отправка репортов...</b>\nЦель: {target}\nТип: <code>SPAM</code>, <code>PORNOGRAPHY</code>\nУспешно отправлено: 145/200...", parse_mode="HTML")
    await asyncio.sleep(3)
    
    await status_msg.edit_text(f"⚠️ <b>Ожидание ответа от серверов Telegram...</b>\nАнализ статуса аккаунта...", parse_mode="HTML")
    await asyncio.sleep(2)
    
    final_text = (
        f"📦 <b>ПИЦЦА ДОСТАВЛЕНА!</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"🎯 Цель: <b>{target}</b>\n"
        f"✅ Жалобы успешно залиты в базу модерации Telegram.\n"
        f"Ожидайте блокировки аккаунта в течение 1–12 часов."
    )
    await status_msg.edit_text(final_text, parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="В меню", callback_data="back_main")]]))

