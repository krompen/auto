@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    ref_id = None
    if " " in message.text:
        potential_ref = message.text.split(" ")[1]
        if potential_ref.isdigit(): ref_id = int(potential_ref)

    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT user_id FROM users WHERE user_id = ?", (message.from_user.id,)) as cursor:
            user_exists = await cursor.fetchone()
            
        if not user_exists:
            await db.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (message.from_user.id, message.from_user.username))
            if ref_id and ref_id != message.from_user.id:
                await db.execute("UPDATE users SET diamonds = diamonds + 5, refs = refs + 1 WHERE user_id = ?", (ref_id,))
                try: await bot.send_message(ref_id, "🎉 <b>Новый реферал!</b> Вам начислено <b>5 💎</b>.", parse_mode=ParseMode.HTML)
                except: pass
        await db.commit()
    
    text = (
        f"👋 <b>Добро пожаловать, {message.from_user.first_name}</b>\n\n"
        "<b>Swithub</b> - многофункциональный ассистент для твоих личных сообщений.\n\n"
        "Чтобы бот начал ловить удаленки, сохранять исчезающие фото/видео и использовать автоответчик, "
        "перейдите в <b>«Гайд по подключению»</b>."
    )
    await message.answer(text, reply_markup=start_kb(message.from_user.id), parse_mode=ParseMode.HTML)

