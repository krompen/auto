                parse_mode=ParseMode.HTML
            )
        else:
            await db.execute("DELETE FROM connections WHERE conn_id = ?", (connection.id,))
        await db.commit()

@dp.business_message()
async def handle_new_business_message(message: Message):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT owner_id FROM connections WHERE conn_id = ?", (message.business_connection_id,)) as cursor:
            owner_row = await cursor.fetchone()
        if not owner_row: return
        owner_id = owner_row[0]

        async with db.execute("SELECT dnd_mode, anti_read FROM users WHERE user_id = ?", (owner_id,)) as cursor:
            settings_row = await cursor.fetchone()
            dnd_mode, anti_read = settings_row if settings_row else (0, 0)

    # Кэшируем текст для отслеживания измененки
    await cache_message(message.business_connection_id, message)

    # --- КОМАНДЫ ВЛАДЕЛЬЦА ---
    if message.from_user.id == owner_id and message.text:
        target_id = message.chat.id
        cmd = message.text.lower().strip()
        
        if cmd == "/help":
            help_text = (
                "🛠 <b>Модули Swithub:</b>\n\n"
                "<code>/mute</code> — автоответчик-заглушка для собеседника\n"
                "<code>/unmute</code> — снять заглушку\n"
                "<code>/dnd</code> — вкл/выкл Режим Сна (ответ всем, что ты занят)\n"
                "<code>/read</code> — вкл/выкл Скрытое чтение\n"
                "<code>/note</code> — (реплай) сохранить сообщение собеседника в бота\n"
                "<code>/price</code> — (шорткат) отправить прайс-лист"
            )
            await bot.send_message(target_id, help_text, business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            
        elif cmd == "/mute":
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("INSERT OR IGNORE INTO muted (owner_id, target_id) VALUES (?, ?)", (owner_id, target_id))
                await db.commit()
            await bot.send_message(target_id, "🔇 <b>Мут активирован.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            
        elif cmd == "/unmute":
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("DELETE FROM muted WHERE owner_id = ? AND target_id = ?", (owner_id, target_id))
                await db.commit()
            await bot.send_message(target_id, "🔊 <b>Мут снят.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            
        elif cmd == "/dnd":
            new_state = 0 if dnd_mode else 1
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("UPDATE users SET dnd_mode = ? WHERE user_id = ?", (new_state, owner_id))
                await db.commit()
            status_text = "включен 🌙" if new_state else "выключен ☀️"
            await bot.send_message(target_id, f"ℹ️ <b>Режим сна {status_text}.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)

        elif cmd == "/read":
            new_state = 0 if anti_read else 1
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute("UPDATE users SET anti_read = ? WHERE user_id = ?", (new_state, owner_id))
                await db.commit()
            status_text = "включено 👁" if new_state else "выключено ❌"
            await bot.send_message(target_id, f"ℹ️ <b>Скрытое чтение {status_text}.</b>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)

        elif cmd == "/note" and message.reply_to_message:
            # Сохранение заметки в личку с ботом
            try:
                await bot.copy_message(chat_id=owner_id, from_chat_id=target_id, message_id=message.reply_to_message.message_id)
                await bot.send_message(target_id, "✅ <i>Успешно сохранено в заметки (ЛС с ботом).</i>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            except: pass

        elif cmd == "/price":
            # Шорткат прайс-листа
            price_text = "💼 <b>Прайс-лист на услуги:</b>\n\n• Базовый тариф — 1000₽\n• Премиум разработка — 5000₽\n• Консультация — 500₽\n\n<i>Для заказа ответьте на это сообщение.</i>"
            await bot.send_message(target_id, price_text, business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
    
    # --- СООБЩЕНИЯ ОТ СОБЕСЕДНИКА ---
    elif message.from_user.id != owner_id:
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT 1 FROM muted WHERE owner_id = ? AND target_id = ?", (owner_id, message.chat.id)) as cursor:
                is_muted = await cursor.fetchone()

        # 1. Сейвер Медиа (Кружочки, Видео, Фото)
        if message.photo or message.video or message.video_note or message.voice:
            sender_name = f"@{message.from_user.username}" if message.from_user.username else message.from_user.first_name
            try:
                await bot.send_message(owner_id, f"📥 <b>Перехват медиа от {sender_name}:</b>", parse_mode=ParseMode.HTML)
                await bot.copy_message(chat_id=owner_id, from_chat_id=message.chat.id, message_id=message.message_id)
            except: pass

        # 2. Скрытое чтение
        if anti_read and message.text:
            sender_name = f"@{message.from_user.username}" if message.from_user.username else message.from_user.first_name
            try:
                await bot.send_message(owner_id, f"👁 <b>{sender_name} пишет:</b>\n\n{message.text}", parse_mode=ParseMode.HTML)
            except: pass

        # 3. Мут (Автоответчик без удаления)
        if is_muted:
            try: await bot.send_message(message.chat.id, "🚫 <i>Пользователь ограничил получение сообщений.</i>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            except: pass
            
        # 4. Режим сна (DND)
        elif dnd_mode:
            try: await bot.send_message(message.chat.id, "🌙 <i>Пользователь сейчас отдыхает. Сообщение доставлено, ответ будет позже.</i>", business_connection_id=message.business_connection_id, parse_mode=ParseMode.HTML)
            except: pass

@dp.edited_business_message()
async def handle_edited_business_message(message: Message):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT owner_id FROM connections WHERE conn_id = ?", (message.business_connection_id,)) as cursor:
            owner_row = await cursor.fetchone()
        if not owner_row: return
        owner_id = owner_row[0]

    msg_unique_id = f"{message.business_connection_id}_{message.chat.id}_{message.message_id}"
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT text FROM msg_cache WHERE msg_id = ?", (msg_unique_id,)) as cursor:
            row = await cursor.fetchone()
            old_text = row[0] if row else "<i>[Текст не был сохранен]</i>"
            
    username = f"@{message.from_user.username}" if message.from_user.username else message.from_user.first_name
    log_text = (
        f"✏️ <b>Изменено сообщение от {username}</b>\n\n"
        f"<b>Было:</b> {old_text}\n"
        f"<b>Стало:</b> {message.text}"
    )
    
    kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="В чат", url=f"tg://resolve?domain={message.chat.username}")]]) if message.chat.username else None
    try: await bot.send_message(owner_id, log_text, reply_markup=kb, parse_mode=ParseMode.HTML)
    except: pass
    await cache_message(message.business_connection_id, message)

