@router.message(StateFilter(SearchStates.admin_grant_vip))
async def grant_vip(message: Message, state: FSMContext, bot: Bot) -> None:
    if message.from_user.id != ADMIN_ID:
        return
    try:
        target, days = (int(x) for x in (message.text or "").split())
        if target <= 0 or days <= 0 or days > 3650:
            raise ValueError
    except ValueError:
        await message.answer("⚠️ Формат: <code>123456789 30</code>")
        return
    with sqlite3.connect(DB_PATH) as conn:
        exists = conn.execute("SELECT 1 FROM users WHERE user_id = ?", (target,)).fetchone()
        if not exists:
            await message.answer("⚠️ Пользователь ещё не запускал бота.")
            return
        conn.execute("UPDATE users SET vip_until = ? WHERE user_id = ?", (now_ts() + days * 86400, target))
    await state.clear()
    await message.answer(f"✅ VIP выдан на {days} дн.", reply_markup=admin_keyboard())
    try:
        await bot.send_message(target, f"🎉 Вам активирован VIP на {days} дней.")
    except Exception:
        logger.info("Could not notify user %s", target)


