# --- Базовые обработчики ---
@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    await add_user(message.from_user.id, message.from_user.username)
    text = (
        f"👋 Привет, <b>{message.from_user.first_name}</b>!\n\n"
        "Если у тебя <b>спамблок</b> в Telegram или ты хочешь задать анонимный вопрос — "
        "выбирай нужный пункт в меню ниже."
    )
    await message.answer(text, reply_markup=main_menu_kb(message.from_user.id), parse_mode="HTML")

@dp.callback_query(F.data == "btn_back")
async def cb_back(call: CallbackQuery, state: FSMContext):
    await state.clear()
    await call.message.edit_text("Главное меню:", reply_markup=main_menu_kb(call.from_user.id))
    await call.answer()

# Новая кнопка отмены для состояний (чтобы не перезаписывать само сообщение, а удалять старое)
@dp.callback_query(F.data == "btn_cancel_action")
async def cb_cancel_action(call: CallbackQuery, state: FSMContext):
    await state.clear()
    await call.message.delete()
    await call.message.answer("Действие отменено. Главное меню:", reply_markup=main_menu_kb(call.from_user.id))
    await call.answer()

