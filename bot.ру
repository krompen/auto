            total_users = (await c1.fetchone())[0]
        async with db.execute("SELECT COUNT(*) FROM messages_log") as c2:
            total_msgs = (await c2.fetchone())[0]
        async with db.execute("SELECT COUNT(*) FROM messages_log WHERE is_anon = 1") as c3:
            total_anon = (await c3.fetchone())[0]

    stats_text = (
        "📈 <b>Статистика:</b>\n\n"
        f"• Людей в базе: <b>{total_users}</b>\n"
        f"• Всего обращений: <b>{total_msgs}</b>\n"
        f"• Из них анонимных: <b>{total_anon}</b>"
    )
    await call.message.edit_text(stats_text, reply_markup=admin_kb(), parse_mode="HTML")
    await call.answer()

@dp.callback_query(F.data.startswith("reply_to_"), F.from_user.id == ADMIN_ID)
async def cb_reply_start(call: CallbackQuery, state: FSMContext):
    target_id = int(call.data.split("_")[2])
    await state.update_data(reply_target=target_id)
    await state.set_state(AdminStates.waiting_for_reply)
    await call.message.answer(f"✍️ Напишите ответ для пользователя <code>{target_id}</code>:", parse_mode="HTML", reply_markup=cancel_kb())
    await call.answer()

@dp.message(StateFilter(AdminStates.waiting_for_reply), F.from_user.id == ADMIN_ID)
async def process_reply(message: Message, state: FSMContext):
    data = await state.get_data()
    target_id = data["reply_target"]
    try:
        await bot.send_message(target_id, "📩 <b>Ответ от администратора:</b>", parse_mode="HTML")
        await bot.copy_message(chat_id=target_id, from_chat_id=message.chat.id, message_id=message.message_id)
        await message.answer(f"✅ Отправлено пользователю <code>{target_id}</code>.")
    except Exception as e:
        await message.answer(f"❌ Не удалось отправить (пользователь заблокировал бота): {e}")
    await state.clear()

@dp.callback_query(F.data == "adm_broadcast", F.from_user.id == ADMIN_ID)
async def cb_broadcast(call: CallbackQuery, state: FSMContext):
    await state.set_state(AdminStates.waiting_for_broadcast)
    await call.message.answer("📢 Отправьте пост для рассылки всем юзерам бота:", reply_markup=cancel_kb())
    await call.answer()

@dp.message(StateFilter(AdminStates.waiting_for_broadcast), F.from_user.id == ADMIN_ID)
async def process_broadcast(message: Message, state: FSMContext):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT user_id FROM users") as cursor:
            users = await cursor.fetchall()

    status = await message.answer(f"⏳ Отправка (всего получателей: {len(users)})...")
    success, failed = 0, 0

    for (uid,) in users:
        try:
            await bot.copy_message(chat_id=uid, from_chat_id=message.chat.id, message_id=message.message_id)
            success += 1
            await asyncio.sleep(0.05)
        except Exception:
            failed += 1

    await status.edit_text(
        f"📢 <b>Рассылка завершена:</b>\n\n• Успешно: <b>{success}</b>\n• Не доставлено: <b>{failed}</b>",
        parse_mode="HTML"
    )
    await state.clear()

# --- Точка входа ---
async def main():
    await init_db()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
