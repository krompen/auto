    except ValueError:
        return await message.answer("❌ Ошибка: отправьте корректный числовой ID.", reply_markup=cancel_kb())

    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT is_banned, is_premium FROM users WHERE user_id = ?", (target_id,)) as cursor:
            row = await cursor.fetchone()
            
